+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+
+profile_init() {
+	if [[ -z "${TARGET_CACHE_GLOB:-}" ]]; then
+		TARGET_CACHE_GLOB='request_sock*'
+	fi
+}
+
+profile_usage() {
+	cat <<'EOF'
+Profile: request_sock
+
+Purpose:
+  Trace request_sock allocation, clone, and free activity while keeping the
+  framework generic. This profile builds on the generic cache watcher and adds
+  request_sock wrapper probes where the symbols are available.
+
+Optional:
+  --cache <glob>        Override the cache glob. Default: 'request_sock*'.
+
+Uses:
+  - Generic cache lifecycle events:
+      t: kmem_cache_alloc
+      t: kmem_cache_free
+  - request_sock wrapper probes:
+      f: inet_reqsk_alloc
+      f: cookie_tcp_reqsk_alloc
+      f: inet_reqsk_clone   (best effort; static symbol visibility varies)
+
+Notes:
+  - Frees fall back to kmem_cache_free filtered by request_sock cache name.
+  - This avoids baking __reqsk_free into the framework core.
+
+Example:
+  sudo scripts/tracing/tracefs-object-watch.sh start \
+      --profile request_sock --pid 1234
+EOF
+}
+
+profile_parse_args() {
+	if [[ $# -gt 0 ]]; then
+		die "profile request_sock does not accept extra options: $*"
+	fi
+}
+
+profile_validate() {
+	require_btf_or_die
+}
+
+profile_install() {
+	install_cache_tracepoint_events
+
+	register_event reqsk_alloc_entry \
+		"f:$GROUP/reqsk_alloc_entry inet_reqsk_alloc ops_name=ops->slab_name:string listener=sk_listener attach=attach_listener"
+	register_event reqsk_alloc_exit \
+		"f:$GROUP/reqsk_alloc_exit inet_reqsk_alloc%return req=\$retval"
+	register_event cookie_reqsk_alloc_entry \
+		"f:$GROUP/cookie_reqsk_alloc_entry cookie_tcp_reqsk_alloc ops_name=ops->slab_name:string sk=sk"
+	register_event cookie_reqsk_alloc_exit \
+		"f:$GROUP/cookie_reqsk_alloc_exit cookie_tcp_reqsk_alloc%return req=\$retval"
+
+	# inet_reqsk_clone() is static, so probe availability depends on the build.
+	try_register_event reqsk_clone_entry \
+		"f:$GROUP/reqsk_clone_entry inet_reqsk_clone req=req sk=sk"
+	try_register_event reqsk_clone_exit \
+		"f:$GROUP/reqsk_clone_exit inet_reqsk_clone%return nreq=\$retval"
+}
+
+profile_apply_filters() {
+	local pid_filter wrapper_filter
+
+	apply_cache_tracepoint_filters
+
+	pid_filter=$(compose_pid_filter)
+	wrapper_filter="$pid_filter"
+
+	if [[ -n "$TARGET_CACHE_GLOB" ]]; then
+		wrapper_filter=$(append_filter_clause "$wrapper_filter" \
+			"ops_name ~ \"$TARGET_CACHE_GLOB\"")
+	fi
+
+	set_event_filter reqsk_alloc_entry "$wrapper_filter"
+	set_event_filter cookie_reqsk_alloc_entry "$wrapper_filter"
+	set_event_filter reqsk_alloc_exit "$pid_filter"
+	set_event_filter cookie_reqsk_alloc_exit "$pid_filter"
+	set_event_filter reqsk_clone_entry "$pid_filter"
+	set_event_filter reqsk_clone_exit "$pid_filter"
+}
+
+profile_summary() {
+	log "cache filter: $TARGET_CACHE_GLOB"
+	if [[ -n "${PID_FILTER:-}" ]]; then
+		log "pid filter: $PID_FILTER"
+	fi
+	log "free tracking: kmem_cache_free filtered by request_sock cache"
+}
diff --git a/scripts/tracing/tracefs-object-watch.sh b/scripts/tracing/tracefs-object-watch.sh
new file mode 100755
index 000000000000..c2062883ac6e
--- /dev/null
+++ b/scripts/tracing/tracefs-object-watch.sh
@@ -0,0 +1,397 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+#
+# Generic tracefs object watcher with profile-based event sets.
+
+set -euo pipefail
+
+SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+FRAMEWORK_DIR="$SCRIPT_DIR/object-watch"
+PROFILE_DIR="$FRAMEWORK_DIR/profiles"
+
+# shellcheck source=/dev/null
+source "$FRAMEWORK_DIR/lib.sh"
+
+TRACEFS=${TRACEFS:-/sys/kernel/tracing}
+INSTANCE=${INSTANCE:-objtrace}
+GROUP=${GROUP:-objtrace}
+BUFFER_KB=${BUFFER_KB:-8192}
+PID_FILTER=
+KEEP_INSTANCE=0
+PROFILE=cache
+TARGET_CACHE_GLOB=
+COMMAND=
+SHOW_PROFILE_HELP=0
+LIST_PROFILES=0
+PROFILE_ARGS=()
+ACTIVE_EVENTS=()
+RUN_ARGS=()
+RUN_AUTOSTART=0
+CONTROL_FIFO=
+RUN_CHILD_PID=
+
+usage() {
+	cat <<'EOF'
+Usage:
+  tracefs-object-watch.sh start [common options] [profile options]
+  tracefs-object-watch.sh stop [common options]
+  tracefs-object-watch.sh run [common options] [profile options] -- <command> [args...]
+
+Common options:
+  --profile <name>      Profile to load. Default: cache.
+  --reqsk               Alias for --profile request_sock.
+  --pid <pid>           Only keep events from this PID.
+  --cache <glob>        Shared cache glob for cache-backed profiles.
+  --instance <name>     tracefs instance name. Default: objtrace.
+  --tracefs <path>      tracefs mount. Default: /sys/kernel/tracing.
+  --buffer-kb <size>    Instance buffer size in KB. Default: 8192.
+  --keep-instance       On stop, leave the tracefs instance directory in place.
+  --autostart           In run mode, start tracing immediately after exec.
+  --profile-help        Show help for the selected profile.
+  --list-profiles       List available profiles.
+  -h, --help            Show this help.
+
+Profiles:
+  cache                 Generic cache-backed object lifecycle watcher.
+  request_sock          request_sock lifecycle watcher with wrapper probes.
+
+Examples:
+  sudo scripts/tracing/tracefs-object-watch.sh start \
+      --profile cache --pid 1234 --cache 'cred_jar'
+
+  sudo scripts/tracing/tracefs-object-watch.sh start \
+      --profile request_sock --pid 1234
+
+  sudo scripts/tracing/tracefs-object-watch.sh run \
+      --profile request_sock -- ./fast_poc
+
+  sudo cat /sys/kernel/tracing/instances/objtrace/trace_pipe
+  sudo scripts/tracing/tracefs-object-watch.sh stop
+EOF
+}
+
+list_profiles() {
+	cat <<'EOF'
+cache
+  Generic cache-backed lifecycle tracing via kmem tracepoint probes.
+
+request_sock
+  request_sock-specific lifecycle tracing layered on the generic cache watcher.
+EOF
+}
+
+load_profile() {
+	local profile_path="$PROFILE_DIR/$PROFILE.sh"
+
+	[[ -e "$profile_path" ]] || die "unknown profile: $PROFILE"
+	# shellcheck source=/dev/null
+	source "$profile_path"
+	profile_init
+}
+
+parse_args() {
+	local cmd="${1:-}"
+	shift || true
+
+	case "$cmd" in
+	start|stop|run)
+		COMMAND="$cmd"
+		;;
+	-h|--help|"")
+		usage
+		exit 0
+		;;
+	*)
+		die "unknown command: $cmd"
+		;;
+	esac
+
+	while [[ $# -gt 0 ]]; do
+		case "$1" in
+		--)
+			shift
+			RUN_ARGS=("$@")
+			break
+			;;
+		--profile)
+			PROFILE="${2:?missing value for --profile}"
+			shift 2
+			;;
+		--reqsk)
+			PROFILE=request_sock
+			shift
+			;;
+		--pid)
+			PID_FILTER="${2:?missing value for --pid}"
+			shift 2
+			;;
+		--cache)
+			TARGET_CACHE_GLOB="${2:?missing value for --cache}"
+			shift 2
+			;;
+		--instance)
+			INSTANCE="${2:?missing value for --instance}"
+			shift 2
+			;;
+		--tracefs)
+			TRACEFS="${2:?missing value for --tracefs}"
+			shift 2
+			;;
+		--buffer-kb)
+			BUFFER_KB="${2:?missing value for --buffer-kb}"
+			shift 2
+			;;
+		--keep-instance)
+			KEEP_INSTANCE=1
+			shift
+			;;
+		--autostart)
+			RUN_AUTOSTART=1
+			shift
+			;;
+		--profile-help)
+			SHOW_PROFILE_HELP=1
+			shift
+			;;
+		--list-profiles)
+			LIST_PROFILES=1
+			shift
+			;;
+		-h|--help)
+			usage
+			exit 0
+			;;
+		*)
+			PROFILE_ARGS+=("$1")
+			shift
+			;;
+		esac
+	done
+}
+
+enable_active_events() {
+	enable_events "${ACTIVE_EVENTS[@]}"
+}
+
+configure_instance() {
+	local inst
+
+	inst=$(instance_dir)
+	mkdir -p "$inst"
+	printf '0\n' >"$inst/tracing_on"
+	write_if_exists "$inst/events/enable" 0
+	printf '%s\n' "$BUFFER_KB" >"$inst/buffer_size_kb"
+	: >"$inst/trace"
+}
+
+prepare_profile() {
+	configure_instance
+	cleanup_framework_dynamic_events
+	profile_parse_args "${PROFILE_ARGS[@]}"
+	profile_validate
+	profile_install
+	profile_apply_filters
+	enable_active_events
+}
+
+start_tracing() {
+	prepare_profile
+	write_if_exists "$(instance_dir)/tracing_on" 1
+
+	log "profile: $PROFILE"
+	log "instance: $(instance_dir)"
+	log "read live events with: cat $(instance_dir)/trace_pipe"
+	profile_summary
+}
+
+print_run_integration_help() {
+	cat >&2 <<EOF
+[tracefs-object-watch] run mode control FIFO exported as:
+[tracefs-object-watch]   $CONTROL_ENV_VAR=$CONTROL_FIFO
+[tracefs-object-watch] POC may write commands:
+[tracefs-object-watch]   begin [tag]  - clear trace buffer and enable tracing
+[tracefs-object-watch]   end [tag]    - write end marker and disable tracing
+[tracefs-object-watch]   mark <text>  - add a trace marker
+EOF
+}
+
+wait_for_stopped_child() {
+	local state=
+
+	while kill -0 "$RUN_CHILD_PID" 2>/dev/null; do
+		state=$(awk '/^State:/ {print $2}' "/proc/$RUN_CHILD_PID/status" 2>/dev/null || true)
+		if [[ "$state" == "T" ]]; then
+			return 0
+		fi
+		sleep 0.01
+	done
+
+	die "failed to stop wrapped child before tracing setup"
+}
+
+spawn_wrapped_child() {
+	CONTROL_FIFO=$(mktemp -u "/tmp/tracefs-object-watch.${INSTANCE}.XXXXXX")
+	mkfifo "$CONTROL_FIFO"
+	chmod 0666 "$CONTROL_FIFO"
+
+	env "$CONTROL_ENV_VAR=$CONTROL_FIFO" \
+		bash -c 'kill -STOP $$; exec "$@"' _ "${RUN_ARGS[@]}" &
+	RUN_CHILD_PID=$!
+	wait_for_stopped_child
+}
+
+handle_control_command() {
+	local line="$1"
+	local cmd arg
+
+	cmd=${line%% *}
+	if [[ "$cmd" == "$line" ]]; then
+		arg=
+	else
+		arg=${line#* }
+	fi
+
+	case "$cmd" in
+	begin|on|start)
+		clear_trace_buffer
+		if [[ -n "$arg" ]]; then
+			write_trace_marker "objwatch begin: $arg"
+		else
+			write_trace_marker "objwatch begin"
+		fi
+		set_tracing_on 1
+		;;
+	end|off|stop)
+		if [[ -n "$arg" ]]; then
+			write_trace_marker "objwatch end: $arg"
+		else
+			write_trace_marker "objwatch end"
+		fi
+		set_tracing_on 0
+		;;
+	mark)
+		write_trace_marker "objwatch mark: ${arg:-unnamed}"
+		;;
+	clear)
+		clear_trace_buffer
+		;;
+	"")
+		;;
+	*)
+		log "ignoring unknown control command: $line"
+		;;
+	esac
+}
+
+control_loop() {
+	local line=
+
+	exec 3<>"$CONTROL_FIFO"
+	while :; do
+		if IFS= read -r -t 0.2 line <&3; then
+			handle_control_command "$line"
+		elif ! kill -0 "$RUN_CHILD_PID" 2>/dev/null; then
+			break
+		fi
+	done
+	exec 3>&-
+}
+
+configure_run_descendant_capture() {
+	if [[ -n "$PID_FILTER" ]]; then
+		die "--pid is not supported with run mode; wrapper mode manages descendant tasks automatically"
+	fi
+
+	set_instance_option event-fork 1
+	set_instance_option markers 1
+	clear_event_pid
+	set_event_pid "$RUN_CHILD_PID"
+}
+
+run_tracing() {
+	local status ctl_pid
+
+	[[ ${#RUN_ARGS[@]} -gt 0 ]] || die "run requires a command after --"
+
+	prepare_profile
+	spawn_wrapped_child
+	configure_run_descendant_capture
+
+	if [[ "$RUN_AUTOSTART" -eq 1 ]]; then
+		clear_trace_buffer
+		write_trace_marker "objwatch autostart"
+		set_tracing_on 1
+	else
+		set_tracing_on 0
+	fi
+
+	print_run_integration_help
+
+	control_loop &
+	ctl_pid=$!
+
+	kill -CONT "$RUN_CHILD_PID"
+	set +e
+	wait "$RUN_CHILD_PID"
+	status=$?
+	set -e
+
+	wait "$ctl_pid" || true
+	rm -f "$CONTROL_FIFO"
+	CONTROL_FIFO=
+	stop_tracing
+	return "$status"
+}
+
+stop_tracing() {
+	local inst
+
+	inst=$(instance_dir)
+	if [[ -d "$inst" ]]; then
+		write_if_exists "$inst/tracing_on" 0
+		write_if_exists "$inst/events/enable" 0
+		: >"$inst/trace" || true
+		: >"$inst/set_event_pid" 2>/dev/null || true
+	fi
+
+	cleanup_framework_dynamic_events
+
+	if [[ -d "$inst" && "$KEEP_INSTANCE" -eq 0 ]]; then
+		rmdir "$inst" 2>/dev/null || \
+			log "could not remove $inst (is trace_pipe or trace still open?)"
+	fi
+}
+
+main() {
+	parse_args "$@"
+
+	if [[ "$LIST_PROFILES" -eq 1 ]]; then
+		list_profiles
+		exit 0
+	fi
+
+	load_profile
+
+	if [[ "$SHOW_PROFILE_HELP" -eq 1 ]]; then
+		profile_usage
+		exit 0
+	fi
+
+	require_root
+	[[ -d "$TRACEFS" ]] || die "tracefs directory not found: $TRACEFS"
+	[[ -e "$TRACEFS/dynamic_events" ]] || die "dynamic_events not available under $TRACEFS"
+
+	case "$COMMAND" in
+	start)
+		start_tracing
+		;;
+	stop)
+		stop_tracing
+		;;
+	run)
+		run_tracing
+		;;
+	esac
+}
+
+main "$@"
-- 
