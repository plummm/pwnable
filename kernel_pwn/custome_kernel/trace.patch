diff --git a/scripts/tracing/object-watch/lib.sh b/scripts/tracing/object-watch/lib.sh
new file mode 100644
index 000000000000..52df1f186d33
--- /dev/null
+++ b/scripts/tracing/object-watch/lib.sh
@@ -0,0 +1,217 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+
+FRAMEWORK_EVENT_NAMES=(
+	cache_alloc
+	cache_free
+	reqsk_alloc_entry
+	reqsk_alloc_exit
+	cookie_reqsk_alloc_entry
+	cookie_reqsk_alloc_exit
+	reqsk_clone_entry
+	reqsk_clone_exit
+)
+
+CONTROL_ENV_VAR=TRACEFS_OBJWATCH_CTL
+
+log() {
+	echo "[tracefs-object-watch] $*" >&2
+}
+
+die() {
+	log "$*"
+	exit 1
+}
+
+require_root() {
+	if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
+		die "run as root"
+	fi
+}
+
+instance_dir() {
+	echo "$TRACEFS/instances/$INSTANCE"
+}
+
+instance_path() {
+	local rel="$1"
+	echo "$(instance_dir)/$rel"
+}
+
+have_btf() {
+	[[ -e /sys/kernel/btf/vmlinux ]]
+}
+
+event_enable_path() {
+	local event="$1"
+	echo "$(instance_dir)/events/$GROUP/$event/enable"
+}
+
+event_filter_path() {
+	local event="$1"
+	echo "$(instance_dir)/events/$GROUP/$event/filter"
+}
+
+write_if_exists() {
+	local path="$1"
+	local value="$2"
+
+	if [[ -e "$path" ]]; then
+		printf '%s\n' "$value" >"$path"
+	fi
+}
+
+instance_write_if_exists() {
+	local rel="$1"
+	local value="$2"
+
+	write_if_exists "$(instance_path "$rel")" "$value"
+}
+
+remove_dynamic_event() {
+	local name="$1"
+	printf '%s\n' "-:$GROUP/$name" >>"$TRACEFS/dynamic_events" 2>/dev/null || true
+}
+
+cleanup_framework_dynamic_events() {
+	local event
+
+	for event in "${FRAMEWORK_EVENT_NAMES[@]}"; do
+		remove_dynamic_event "$event"
+	done
+}
+
+add_dynamic_event() {
+	local definition="$1"
+	printf '%s\n' "$definition" >>"$TRACEFS/dynamic_events"
+}
+
+register_event() {
+	local name="$1"
+	local definition="$2"
+
+	add_dynamic_event "$definition"
+	ACTIVE_EVENTS+=("$name")
+}
+
+try_register_event() {
+	local name="$1"
+	local definition="$2"
+
+	if ! printf '%s\n' "$definition" >>"$TRACEFS/dynamic_events" 2>/dev/null; then
+		log "skipping unsupported probe: $definition"
+		return 1
+	fi
+
+	ACTIVE_EVENTS+=("$name")
+	return 0
+}
+
+set_event_filter() {
+	local event="$1"
+	local expr="$2"
+
+	if [[ -n "$expr" ]]; then
+		write_if_exists "$(event_filter_path "$event")" "$expr"
+	fi
+}
+
+enable_events() {
+	local event
+
+	for event in "$@"; do
+		write_if_exists "$(event_enable_path "$event")" 1
+	done
+}
+
+set_tracing_on() {
+	instance_write_if_exists tracing_on "$1"
+}
+
+clear_trace_buffer() {
+	: >"$(instance_path trace)"
+}
+
+set_instance_option() {
+	local name="$1"
+	local value="$2"
+	local option_path
+
+	option_path="$(instance_path "options/$name")"
+	if [[ -e "$option_path" ]]; then
+		printf '%s\n' "$value" >"$option_path"
+	elif [[ "$value" == "1" ]]; then
+		instance_write_if_exists trace_options "$name"
+	else
+		instance_write_if_exists trace_options "no$name"
+	fi
+}
+
+set_event_pid() {
+	instance_write_if_exists set_event_pid "$1"
+}
+
+clear_event_pid() {
+	: >"$(instance_path set_event_pid)"
+}
+
+write_trace_marker() {
+	local message="$1"
+	instance_write_if_exists trace_marker "$message"
+}
+
+append_filter_clause() {
+	local current="$1"
+	local clause="$2"
+
+	if [[ -z "$clause" ]]; then
+		printf '%s' "$current"
+		return
+	fi
+
+	if [[ -n "$current" ]]; then
+		printf '%s && %s' "$current" "$clause"
+	else
+		printf '%s' "$clause"
+	fi
+}
+
+compose_pid_filter() {
+	if [[ -n "${PID_FILTER:-}" ]]; then
+		printf 'common_pid == %s' "$PID_FILTER"
+	fi
+}
+
+compose_cache_filter() {
+	local expr
+
+	expr=$(compose_pid_filter)
+	if [[ -n "${TARGET_CACHE_GLOB:-}" ]]; then
+		expr=$(append_filter_clause "$expr" "cache ~ \"$TARGET_CACHE_GLOB\"")
+	fi
+
+	printf '%s' "$expr"
+}
+
+require_btf_or_die() {
+	if ! have_btf; then
+		die "BTF data not found at /sys/kernel/btf/vmlinux"
+	fi
+}
+
+install_cache_tracepoint_events() {
+	require_btf_or_die
+
+	register_event cache_alloc \
+		"t:$GROUP/cache_alloc kmem_cache_alloc obj=ptr cache=s->name:string call_site=call_site:symstr bytes_req=s->object_size:u64 bytes_alloc=s->size:u64 gfp=gfp_flags:x64 node=node:s32"
+	register_event cache_free \
+		"t:$GROUP/cache_free kmem_cache_free obj=ptr cache=s->name:string call_site=call_site:symstr"
+}
+
+apply_cache_tracepoint_filters() {
+	local cache_filter
+
+	cache_filter=$(compose_cache_filter)
+	set_event_filter cache_alloc "$cache_filter"
+	set_event_filter cache_free "$cache_filter"
+}
diff --git a/scripts/tracing/object-watch/poc_control.h b/scripts/tracing/object-watch/poc_control.h
new file mode 100644
index 000000000000..a6473c62c941
--- /dev/null
+++ b/scripts/tracing/object-watch/poc_control.h
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef TRACEFS_OBJECT_WATCH_POC_CONTROL_H
+#define TRACEFS_OBJECT_WATCH_POC_CONTROL_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#ifndef TRACEFS_OBJWATCH_CTL_ENV
+#define TRACEFS_OBJWATCH_CTL_ENV "TRACEFS_OBJWATCH_CTL"
+#endif
+
+static inline int objwatch_send_command(const char *fmt, ...)
+{
+	const char *path = getenv(TRACEFS_OBJWATCH_CTL_ENV);
+	char buf[512];
+	va_list ap;
+	int fd, len;
+
+	if (!path || !*path)
+		return -ENODEV;
+
+	va_start(ap, fmt);
+	len = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (len < 0)
+		return -EINVAL;
+	if ((size_t)len >= sizeof(buf))
+		return -E2BIG;
+
+	fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+
+	if (write(fd, buf, len) != len) {
+		int saved = errno ? -errno : -EIO;
+		close(fd);
+		return saved;
+	}
+
+	close(fd);
+	return 0;
+}
+
+static inline int objwatch_begin(const char *tag)
+{
+	if (tag && *tag)
+		return objwatch_send_command("begin %s\n", tag);
+	return objwatch_send_command("begin\n");
+}
+
+static inline int objwatch_end(const char *tag)
+{
+	if (tag && *tag)
+		return objwatch_send_command("end %s\n", tag);
+	return objwatch_send_command("end\n");
+}
+
+static inline int objwatch_mark(const char *tag)
+{
+	if (tag && *tag)
+		return objwatch_send_command("mark %s\n", tag);
+	return objwatch_send_command("mark\n");
+}
+
+static inline int objwatch_clear(void)
+{
+	return objwatch_send_command("clear\n");
+}
+
+static inline bool objwatch_available(void)
+{
+	const char *path = getenv(TRACEFS_OBJWATCH_CTL_ENV);
+
+	return path && *path;
+}
+
+#endif /* TRACEFS_OBJECT_WATCH_POC_CONTROL_H */
diff --git a/scripts/tracing/object-watch/profiles/cache.sh b/scripts/tracing/object-watch/profiles/cache.sh
