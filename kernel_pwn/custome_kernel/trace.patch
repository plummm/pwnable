+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+
+profile_init() {
+	:
+}
+
+profile_usage() {
+	cat <<'EOF'
+Profile: cache
+
+Purpose:
+  Watch cache-backed object lifecycles through kmem tracepoint probes.
+
+Required:
+  --cache <glob>        Cache-name glob, e.g. 'cred_jar' or 'request_sock*'.
+
+Uses:
+  - t: kmem_cache_alloc
+  - t: kmem_cache_free
+
+Output fields:
+  obj, cache, call_site, bytes_req, bytes_alloc, gfp, node
+
+Example:
+  sudo scripts/tracing/tracefs-object-watch.sh start \
+      --profile cache --pid 1234 --cache 'cred_jar'
+EOF
+}
+
+profile_parse_args() {
+	if [[ $# -gt 0 ]]; then
+		die "profile cache does not accept extra options: $*"
+	fi
+}
+
+profile_validate() {
+	if [[ -z "${TARGET_CACHE_GLOB:-}" ]]; then
+		die "--cache is required for profile cache"
+	fi
+
+	require_btf_or_die
+}
+
+profile_install() {
+	install_cache_tracepoint_events
+}
+
+profile_apply_filters() {
+	apply_cache_tracepoint_filters
+}
+
+profile_summary() {
+	log "cache filter: $TARGET_CACHE_GLOB"
+	if [[ -n "${PID_FILTER:-}" ]]; then
+		log "pid filter: $PID_FILTER"
+	fi
+}
diff --git a/scripts/tracing/object-watch/profiles/request_sock.sh b/scripts/tracing/object-watch/profiles/request_sock.sh
new file mode 100644
